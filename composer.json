{
    "name": "spryker-eco/new-relic",
    "type": "library",
    "description": "NewRelic module",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "spryker/application-extension": "^1.1.0",
        "spryker/guzzle": "^2.4.0",
        "spryker/kernel": "^3.79.0",
        "spryker/monitoring-extension": "^1.1.0",
        "spryker/symfony": "^3.18.0"
    },
    "require-dev": {
        "codeception/module-asserts": "^3.3",
        "phpstan/phpstan": "^1.2.0",
        "spryker/code-sniffer": "*",
        "spryker/testify": "*"
    },
    "autoload": {
        "psr-4": {
            "SprykerEco\\": "src/SprykerEco/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerEcoTest\\": "tests/SprykerEcoTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/Spryker/ruleset.xml src/ tests/",
        "phpstan": "phpstan analyse -c phpstan.neon -l 5 src/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "conflict": {
        "spryker/new-relic": "*",
        "spryker/new-relic-api": "*"
    }
}
